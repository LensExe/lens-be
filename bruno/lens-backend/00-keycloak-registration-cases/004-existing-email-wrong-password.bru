meta {
  name: Existing Keycloak account rejects a wrong password
  type: http
  seq: 4
}

docs {
  Existing Keycloak account rejects a wrong password.
  Dùng biến local.bru; request này gọi Keycloak và có thể tạo account thật trong realm local.
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "customer",
    "fullname": "Bruno Test User",
    "email": "{{registrationEmail}}",
    "password": "{{wrongPassword}}"
  }
}

tests {
  test("returns expected status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
