meta {
  name: Register rejects a short password
  type: http
  seq: 2
}

docs {
  Register rejects a short password.
  Dùng biến local.bru; request này gọi Keycloak và có thể tạo account thật trong realm local.
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "customer",
    "fullname": "Bruno Test User",
    "email": "{{registrationEmail}}",
    "password": "123"
  }
}

tests {
  test("returns expected status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
