meta {
  name: keycloak/google/callback
  type: http
  seq: 168
}

docs {
  Nhận callback Google từ Keycloak
  Handler: callback
  Authentication: public
  Query: GoogleCallbackQuery
}

get {
  url: {{baseUrl}}/keycloak/google/callback?code={{googleCode}}&state={{googleState}}
  body: none
  auth: none
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
