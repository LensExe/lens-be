meta {
  name: portfolios/:portfolio_id/items/reorder
  type: http
  seq: 217
}

docs {
  Sắp xếp ảnh portfolio
  Handler: reorder
  Authentication: role 'photographer'
  Body: PortfolioReorderCommandBodyDto
}

patch {
  url: {{baseUrl}}/portfolios/{{portfolioId}}/items/reorder
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{photographerToken}}
  Content-Type: application/json
}

body:json {
  {
    "portfolio_item_ids": [
      "{{portfolioItemId}}"
    ]
  }
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
