meta {
  name: auth/refresh
  type: http
  seq: 109
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "eyJhbGciOiJIUzUxMiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJjZmFkYzE1MS02MzU4LTQ0NWQtODU2Yi04ZDQyYjJiMmUxZGIifQ..YURvrZaS-Qjh6VP1vm514kq0-Mw8tv4cDp0FC_fGgmh0XSdGHSGj54mvT34Sskg9I61nOP_vq-kb46FDQ5DqPg"
  }
}

script:post-response {
  if (res.getStatus() < 300) {
    const body = res.getBody();
    if (body && body.access_token) {
      bru.setVar("accessToken", body.access_token);
      bru.setVar("customerToken", body.access_token);
      if (body.refresh_token) bru.setVar("refreshToken", body.refresh_token);
    }
  }
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Làm mới token
  Handler: refresh
  Authentication: public
  Body: AuthRefreshDto
}
