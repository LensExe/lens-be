meta {
  name: auth/forgot-password/send-otp
  type: http
  seq: 112
}

docs {
  Quên mật khẩu. Gửi OTP
  Handler: sendForgotPasswordOtp
  Authentication: public
  Body: AuthSendOtpDto
}

post {
  url: {{baseUrl}}/auth/forgot-password/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{registrationEmail}}"
  }
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
