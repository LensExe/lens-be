meta {
  name: auth/forgot-password/verify
  type: http
  seq: 113
}

post {
  url: {{baseUrl}}/auth/forgot-password/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{registrationEmail}}",
    "otp": "705601"
  }
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Xác minh OTP quên mật khẩu
  Handler: verifyForgotPasswordOtp
  Authentication: public
  Body: AuthVerifyForgotPasswordOtpDto
}
