meta {
  name: auth/forgot-password/reset
  type: http
  seq: 114
}

docs {
  Đặt lại mật khẩu mới
  Handler: resetPassword
  Authentication: public
  Body: AuthResetPasswordDto
}

post {
  url: {{baseUrl}}/auth/forgot-password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reset_token": "{{resetToken}}",
    "new_password": "{{newPassword}}",
    "confirm_password": "{{newPassword}}"
  }
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
