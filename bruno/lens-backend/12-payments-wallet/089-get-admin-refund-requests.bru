meta {
  name: admin/refund-requests
  type: http
  seq: 189
}

docs {
  Danh sách refund/rút tiền cần xử lý
  Handler: adminRefundRequests
  Authentication: role 'admin'
  Query: PaymentRefundQueueQueryDto
}

get {
  url: {{baseUrl}}/admin/refund-requests?limit=20&offset=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
