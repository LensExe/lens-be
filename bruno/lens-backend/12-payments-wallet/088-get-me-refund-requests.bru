meta {
  name: me/refund-requests
  type: http
  seq: 188
}

docs {
  Danh sách yêu cầu refund/rút ví của tôi
  Handler: myRefundRequests
  Authentication: role 'customer', 'photographer'
  Query: PaymentWalletLedgerQueryDto
}

get {
  url: {{baseUrl}}/me/refund-requests?limit=20&offset=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{photographerToken}}
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}
