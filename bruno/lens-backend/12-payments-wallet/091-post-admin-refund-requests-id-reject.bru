meta {
  name: admin/refund-requests/:refund_request_id/reject
  type: http
  seq: 191
}

docs {
  Từ chối refund/rút tiền
  Handler: rejectRefund
  Authentication: role 'admin'
  Body: PaymentRefundReviewBodyDto
}

post {
  url: {{baseUrl}}/admin/refund-requests/{{refundRequestId}}/reject
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "reason": "Bruno API test decision",
    "payout_destination": {
      "bank_code": "VCB",
      "account_number": "0123456789",
      "account_name": "BRUNO TEST"
    }
  }
}

tests {
