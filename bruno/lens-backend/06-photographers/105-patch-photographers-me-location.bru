meta {
  name: photographers/me/location
  type: http
  seq: 205
}

docs {
  Cập nhật khu vực phục vụ
  Handler: location
  Authentication: role 'photographer'
  Body: PhotographerLocationCommandBodyDto
}

patch {
  url: {{baseUrl}}/photographers/me/location
  body: json
  auth: none
}

