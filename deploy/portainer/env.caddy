# Environment variables for deploy/portainer/lens-caddy.yml
# Copy these values into Portainer -> Stack -> Environment variables.

# Required by the Caddy ACME issuer.
ACME_EMAIL=anhdonguyennhi@gmail.com

# Public domains pointing to this server.
LANDING_DOMAIN=lens.id.vn
PORTAL_DOMAIN=app.lens.id.vn
ADMIN_DOMAIN=admin.lens.id.vn
BACKEND_DOMAIN=api.lens.id.vn
KONG_DOMAIN=kong.lens.id.vn
KEYCLOAK_DOMAIN=auth.lens.id.vn
MINIO_S3_DOMAIN=s3.lens.id.vn
MINIO_CONSOLE_DOMAIN=minio-console.lens.id.vn
PORTAINER_DOMAIN=portainer.lens.id.vn

# Docker DNS name and internal port of Kong on the lens-proxy network.
KONG_UPSTREAM=lens-kong:8000

# Docker DNS alias and HTTP port of Portainer on the lens-proxy network.
PORTAINER_UPSTREAM=portainer:9000
